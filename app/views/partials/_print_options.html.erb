<%#
  Shared print options used by the Deck URL, Card List, and Campaigns tabs.
  IDs are suffixed with the tab name (passed as `tab` local) so each tab has
  independent state even though the markup is identical.
  e.g. tab="deck" → #print_backs_check_deck, #card_spacing_select_deck
%>

<div class="mb-3">
  <label for="card_spacing_select_<%= tab %>" class="form-label">Spacing between cards</label>
  <select class="form-select card-spacing-select" id="card_spacing_select_<%= tab %>">
    <option value="none">No spacing (edge-to-edge)</option>
    <option value="home" selected>2mm gap &mdash; better suited for home printing</option>
    <option value="printshop">3mm gap &mdash; better suited for printshop printing</option>
  </select>
  <div class="form-text">A bigger gap leaves more room for an imprecise cut, but eats into the page's outer margin. Home printers usually have a larger hardware-enforced margin, so the smaller gap prints more reliably there; a printshop that trims to size can use the larger gap.</div>
</div>

<div class="form-check mb-4">
  <input class="form-check-input print-backs-check" type="checkbox" id="print_backs_check_<%= tab %>" >
  <label class="form-check-label" for="print_backs_check_<%= tab %>">
    Print card backs (duplex front/back pages)
  </label>
</div>

<div class="mb-4 duplex-mode-section" id="duplexModeSection_<%= tab %>">
  <label class="form-label d-block">Duplex printing (front/back page pairing)</label>
  <div class="duplex-mode-options">
    <label class="duplex-mode-option">
      <input class="form-check-input" type="radio" name="duplex_mode_<%= tab %>" value="none" checked>
      <span class="form-check-label">No mirroring</span>
      <span class="duplex-diagram" aria-hidden="true">
        <span class="duplex-grid">
          <% (1..9).each do |n| %><span><%= n %></span><% end %>
        </span>
        <span class="duplex-arrow">&rarr;</span>
        <span class="duplex-grid">
          <% [1, 2, 3, 4, 5, 6, 7, 8, 9].each do |n| %><span><%= n %></span><% end %>
        </span>
      </span>
    </label>
    <label class="duplex-mode-option">
      <input class="form-check-input" type="radio" name="duplex_mode_<%= tab %>" value="long_edge">
      <span class="form-check-label">Long-edge flip (mirrors columns)</span>
      <span class="duplex-diagram" aria-hidden="true">
        <span class="duplex-grid">
          <% (1..9).each do |n| %><span><%= n %></span><% end %>
        </span>
        <span class="duplex-arrow">&rarr;</span>
        <span class="duplex-grid">
          <% [3, 2, 1, 6, 5, 4, 9, 8, 7].each do |n| %><span><%= n %></span><% end %>
        </span>
      </span>
    </label>
    <label class="duplex-mode-option">
      <input class="form-check-input" type="radio" name="duplex_mode_<%= tab %>" value="short_edge">
      <span class="form-check-label">Short-edge flip (mirrors rows)</span>
      <span class="duplex-diagram" aria-hidden="true">
        <span class="duplex-grid">
          <% (1..9).each do |n| %><span><%= n %></span><% end %>
        </span>
        <span class="duplex-arrow">&rarr;</span>
        <span class="duplex-grid">
          <% [7, 8, 9, 4, 5, 6, 1, 2, 3].each do |n| %><span><%= n %></span><% end %>
        </span>
      </span>
    </label>
  </div>
  <div class="form-text">Pick the method matching your printshop's duplex setting. Numbers show where each front-page card lands on the back page.</div>
</div>
