<div class="container my-5">
  <div class="row justify-content-center">
    <div class="col-md-8 col-lg-8">
      <div class="card shadow-sm">
        <div class="card-body mb-3">
          <h2 class="card-title text-center mb-4">ArkhamPrint.XYZ</h2>
          <p class="card-text text-center mb-3">
            ArkhamPrint.XYZ helps players print proxy decks at home and uses <%= link_to "ArkhamDB", "https://arkhamdb.com", target: :_blank %> for card images.
          </p>

          <!-- Tabs -->
          <ul class="nav nav-tabs mb-4" id="pdfTab" role="tablist">
            <li class="nav-item" role="presentation">
              <button class="nav-link active" id="from-deck-tab" data-bs-toggle="tab" data-bs-target="#from-deck" type="button" role="tab">
                From Deck URL
              </button>
            </li>
            <li class="nav-item" role="presentation">
              <button class="nav-link" id="from-cardlist-tab" data-bs-toggle="tab" data-bs-target="#from-cardlist" type="button" role="tab">
                From Card List
              </button>
            </li>
            <li class="nav-item" role="presentation">
              <button class="nav-link" id="campaigns-tab" data-bs-toggle="tab" data-bs-target="#campaigns" type="button" role="tab">
                Campaigns
              </button>
            </li>
          </ul>

          <!-- Tab content -->
          <div class="tab-content" id="pdfTabContent">

            <!-- From Deck URL -->
            <div class="tab-pane fade show active" id="from-deck" role="tabpanel">
              <form id="pdfForm">
                <div class="mb-3 mt-5">
                  <label for="deck_url" class="form-label">ArkhamDB Deck URL or Deck ID</label>
                  <input type="text" id="deck_url" class="form-control" placeholder="https://arkhamdb.com/decklist/view/48985 or 48985">
                </div>
                <%= render "partials/print_options", tab: "deck" %>
                <button type="submit" class="btn btn-primary w-100" id="generatePdfBtn">
                  Get PDF
                </button>
              </form>
            </div>

            <!-- From Card List -->
            <div class="tab-pane fade" id="from-cardlist" role="tabpanel">
              <form id="pdfFormCardList">
                <div class="mb-3 mt-5">
                  <label for="card_list" class="form-label">List of ArkhamDB CardID's (comma or space separated)</label>
                  <input type="text" class="form-control" id="card_list" placeholder="10019, 60111, 01000 06111">
                </div>
                <%= render "partials/print_options", tab: "cardlist" %>
                <button type="submit" class="btn btn-primary w-100" id="generateCardListBtn">
                  Get PDF
                </button>
              </form>
            </div>

            <!-- Campaigns -->
            <div class="tab-pane fade" id="campaigns" role="tabpanel">
              <form id="pdfFromCampaignForm">
                <div class="mb-3 mt-5">
                  <label for="campaign-title" class="form-label">Campaigns</label>
                  <select id="campaign-title" class="form-select" aria-label="Campaign scenario">
                    <% @campaigns.each do |campaign| %>
                    <optgroup label="<%= campaign.fetch("name") %>">
                      <% campaign.fetch("scenarios").each do |scenario| %>
                      <option value="<%= scenario.fetch("title") %>" data-campaign-file="<%= campaign.fetch("file") %>"><%= scenario.fetch("label") %></option>
                      <% end %>
                    </optgroup>
                    <% end %>
                  </select>
                </div>
                <%= render "partials/print_options", tab: "campaign" %>
                <div class="mb-4 text-center">
                  <a href="/example_print_layout.jpg" target="_blank" rel="noopener">
                    <img src="/example_print_layout.jpg" alt="Example output page: a 3x3 grid of cards with a 2mm gap between them" class="img-thumbnail" style="max-width: 220px;">
                  </a>
                  <div class="form-text">Example output page (click to enlarge) &mdash; cards are printed at full size with a small gap between them, so cutting doesn't slice into a neighboring card.</div>
                </div>
                <button type="submit" class="btn btn-primary w-100" id="generateCampaignPdfBtn">
                  Get PDF
                </button>
              </form>
            </div>

          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .duplex-mode-options {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .duplex-mode-option {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    border: 1px solid #dee2e6;
    border-radius: 0.375rem;
    padding: 0.5rem 0.75rem;
    cursor: pointer;
  }

  .duplex-mode-option:has(input:checked) {
    border-color: #0d6efd;
    background-color: rgba(13, 110, 253, 0.05);
  }

  .duplex-mode-option .form-check-label {
    flex: 1 0 auto;
    min-width: 12rem;
  }

  .duplex-diagram {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin-left: auto;
  }

  .duplex-grid {
    display: grid;
    grid-template-columns: repeat(3, 1.1rem);
    grid-template-rows: repeat(3, 1.1rem);
    gap: 1px;
  }

  .duplex-grid span {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.6rem;
    background-color: #e9ecef;
    color: #495057;
  }

  .duplex-arrow {
    color: #6c757d;
  }
</style>

<%= render "partials/modals" %>

<script>
  const deckModalEl = document.getElementById("byDeckUrlModal");
  let modalInstance;

  // Shared by all three "generate PDF" forms.
  function progressModalHtml() {
    return `
      <div class="modal-body">
        <div class="d-flex justify-content-center align-items-center mb-2">
          <div class="spinner-border" role="status" style="width: 3rem; height: 3rem;"></div>
          <span class="ms-3" id="pdfJobStatusText">Submitting job...</span>
        </div>
        <div class="progress mb-3">
          <div id="pdfJobProgressBar" class="progress-bar progress-bar-striped progress-bar-animated" role="progressbar" style="width: 0%">0%</div>
        </div>
        <div class="text-center">
          <button type="button" class="btn btn-outline-danger btn-sm" id="pdfJobCancelBtn">Cancel</button>
        </div>
      </div>
    `;
  }

  // Read the shared print options for a given tab suffix.
  function printOptions(tab) {
    return {
      print_backs:  $(`#print_backs_check_${tab}`).is(':checked'),
      card_spacing: $(`#card_spacing_select_${tab}`).val(),
      duplex_mode:  $(`input[name="duplex_mode_${tab}"]:checked`).val()
    };
  }

  // Wire up duplex section visibility for a given tab suffix.
  function initDuplexToggle(tab) {
    const toggle = () => $(`#duplexModeSection_${tab}`).toggle($(`#print_backs_check_${tab}`).is(':checked'));
    $(`#print_backs_check_${tab}`).on('change', toggle);
    toggle();
  }

  function extractDeckId(input) {
    input = input.trim();
    const match = input.match(/\/view\/(\d+)/);
    if (match) return match[1];
    if (/^\d+$/.test(input)) return input;
    return null;
  }

  function showModal(modalContent) {
    modalInstance = new bootstrap.Modal(deckModalEl, { backdrop: "static", keyboard: false });
    modalInstance.show();
    modalContent.html(progressModalHtml());
  }

  function submitPdfJob() {
    const deckId = extractDeckId($('#deck_url').val());
    if (!deckId) { alert("Invalid deck URL or ID"); return; }

    const modalContent = $("#byDeckUrlModalContent");
    showModal(modalContent);

    fetch("/pdf_jobs", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          deck_id: deckId,
          ...printOptions('deck')
        })
      })
      .then(res => res.json())
      .then(data => {
        gtag("event", "deck_job_created", { "deck_id": deckId, "pdf_job_id": data.pdf_job_id });
        pollPdfJob(data.pdf_job_id);
      })
      .catch(err => {
        modalInstance._config.backdrop = true;
        modalInstance._config.keyboard = true;
        modalContent.html(`<div class="modal-body text-center text-danger">Error: ${err.message}</div>`);
        console.error(err);
      });
  }

  function pollPdfJob(pdfJobId) {
    const interval = 2000;
    const maxConsecutiveErrors = 5;
    const startTime = Date.now();
    const modalContent = $("#byDeckUrlModalContent");
    const statusText = $("#pdfJobStatusText");
    const progressBar = $("#pdfJobProgressBar");
    let consecutiveErrors = 0;

    $(document).off("click", "#pdfJobCancelBtn").on("click", "#pdfJobCancelBtn", function() {
      $(this).prop("disabled", true).text("Cancelling...");
      fetch(`/pdf_jobs/${pdfJobId}/cancel`, { method: "POST" }).catch(err => console.error(err));
    });

    function checkStatus() {
      fetch(`/pdf_jobs/${pdfJobId}`, { headers: { "Accept": "application/json" } })
        .then(res => {
          const contentType = res.headers.get("content-type") || "";
          if (!res.ok || !contentType.includes("application/json")) {
            throw Object.assign(new Error("server_unavailable"), { status: res.status });
          }
          return res.json();
        })
        .then(data => {
          consecutiveErrors = 0;
          if (data.status === "completed") {
            const elapsedSec = Math.floor((Date.now() - startTime) / 1000);
            gtag("event", "deck_pdf_completed", { "pdf_job_id": pdfJobId, "duration_seconds": elapsedSec });
            const downloadUrl = data.file_url.startsWith("http") ? data.file_url : `/pdf_jobs/${pdfJobId}/download`;
            window.open(downloadUrl, "_blank");
            modalContent.html(`<div class="modal-body text-center">Download ready!</div>`);
            modalInstance._config.backdrop = true;
            modalInstance._config.keyboard = true;
            setTimeout(() => modalInstance.hide(), 2000);
          } else if (data.status === "failed") {
            modalInstance._config.backdrop = true;
            modalInstance._config.keyboard = true;
            modalContent.html(`<div class="modal-body text-center text-danger">Failed: ${data.error_message}</div>`);
            gtag("event", "deck_pdf_failed", { "pdf_job_id": pdfJobId, "error_message": data.error_message });
          } else if (data.status === "cancelled") {
            modalInstance._config.backdrop = true;
            modalInstance._config.keyboard = true;
            modalContent.html(`<div class="modal-body text-center">Cancelled.</div>`);
          } else {
            let progress = 0;
            if (data.current_progress && data.max_progress) {
              progress = Math.floor((data.current_progress / data.max_progress) * 100);
            }
            progressBar.css("width", progress + "%").text(progress + "%");
            // The first slice of progress is the card-metadata warm-up phase
            // (fetching card backs from ArkhamDB) rather than drawing.
            if (!data.max_progress) {
              statusText.text("Processing...");
            } else if (progress < 10) {
              statusText.text("Preparing card data...");
            } else {
              statusText.text(`Printing card ${data.current_progress}/${data.max_progress}...`);
            }
            setTimeout(checkStatus, interval);
          }
        })
        .catch(err => {
          consecutiveErrors++;
          console.error(err);
          if (consecutiveErrors < maxConsecutiveErrors) {
            statusText.text("Connection hiccup, retrying...");
            setTimeout(checkStatus, interval);
          } else {
            modalInstance._config.backdrop = true;
            modalInstance._config.keyboard = true;
            const isServerDown = err.message === "server_unavailable" || err.message === "Failed to fetch";
            modalContent.html(`<div class="modal-body text-center text-danger">${isServerDown ? "The server is temporarily unavailable. Please try again in a moment." : "Something went wrong. Please try again."}</div>`);
          }
        });
    }
    checkStatus();
  }

  // From Deck URL
  $('#pdfForm').on('submit', function(e) {
    e.preventDefault();
    submitPdfJob();
  });

  // From Card List
  $('#pdfFormCardList').on('submit', function(e) {
    e.preventDefault();
    const cardListArray = parseCardList($('#card_list').val());
    const modalContent = $("#byDeckUrlModalContent");
    showModal(modalContent);

    fetch("/pdf_jobs", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          card_ids: cardListArray,
          ...printOptions('cardlist')
        })
      })
      .then(res => res.json())
      .then(data => {
        gtag("event", "card_list_job_created", { "card_ids": cardListArray, "pdf_job_id": data.pdf_job_id });
        pollPdfJob(data.pdf_job_id);
      })
      .catch(err => {
        modalInstance._config.backdrop = true;
        modalInstance._config.keyboard = true;
        modalContent.html(`<div class="modal-body text-center text-danger">Error: ${err.message}</div>`);
        console.error(err);
      });
  });

  // From Campaign
  $('#pdfFromCampaignForm').on('submit', function(e) {
    e.preventDefault();
    const selectedScenario = $('#campaign-title').find(":selected");
    const campaignTitle = selectedScenario.val();
    const campaignFile = selectedScenario.data("campaign-file");
    if (!campaignTitle || campaignTitle.length === 0) { alert("Invalid Campaign title"); return; }

    const modalContent = $("#byDeckUrlModalContent");
    showModal(modalContent);

    fetch("/pdf_jobs", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          scenario_title: campaignTitle,
          campaign_file: campaignFile,
          ...printOptions('campaign')
        })
      })
      .then(res => res.json())
      .then(data => {
        gtag("event", "deck_job_created", { "scenario_title": campaignTitle, "pdf_job_id": data.pdf_job_id });
        pollPdfJob(data.pdf_job_id);
      })
      .catch(err => {
        modalInstance._config.backdrop = true;
        modalInstance._config.keyboard = true;
        modalContent.html(`<div class="modal-body text-center text-danger">Error: ${err.message}</div>`);
        console.error(err);
      });
  });

  // Initialise duplex toggle for all three tabs
  initDuplexToggle('deck');
  initDuplexToggle('cardlist');
  initDuplexToggle('campaign');

  function parseCardList(input) {
    if (!input) return [];
    return input.split(/[\s,]+/).map(s => s.trim()).filter(Boolean);
  }
</script>
